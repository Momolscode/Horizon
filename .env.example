# HORIZON — variables d'environnement (copier en .env.local ; ne jamais committer de valeurs réelles)

# ——— Mode ———
# demo (défaut) : aucune clé requise, données de démonstration, progression locale au navigateur.
# connected     : comptes réels et base Supabase. Si une variable manque, l'application affiche une erreur
#                 de configuration (elle ne bascule jamais en démo).
NEXT_PUBLIC_HORIZON_MODE=demo

# ——— Mode connecté : Supabase (navigateur) ———
# URL du projet et clé PUBLIABLE (anciennement « anon »). Jamais la clé secrète ici.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# ——— Mode connecté : serveur uniquement (jamais préfixées NEXT_PUBLIC_) ———
# Connexion PostgreSQL (pooler Supabase en mode transaction en production serverless).
DATABASE_URL=
DATABASE_POOL_MAX=5
# Sel pour hacher les IP de la liste d'attente (anti-abus). Laisser vide = aucune IP conservée.
WAITLIST_HASH_SALT=
# Comptes administrateurs : gérés en base (table public.admins), pas par variable.

# ——— Fournisseurs facultatifs (adaptateurs) ———
# Style MapLibre d'un fournisseur de tuiles (conditions et attribution à vérifier avant usage).
# Vide = fond Natural Earth embarqué (domaine public, carte simplifiée).
NEXT_PUBLIC_MAP_STYLE_URL=
NEXT_PUBLIC_MAP_ATTRIBUTION=
# Météo : vide = « prévisions indisponibles ». open-meteo = Open-Meteo (usage commercial soumis à abonnement, à vérifier).
NEXT_PUBLIC_WEATHER_PROVIDER=

# ——— Divers ———
# Adresse affichée dans Paramètres > Assistance. Vide = « non configurée ».
NEXT_PUBLIC_SUPPORT_EMAIL=
